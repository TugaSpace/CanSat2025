// Pinos
#define PIN_CE D10
#define PIN_CSN D9
#define PIN_GPS_RX A1
#define PIN_GPS_TX A0
#define PIN_BUZZER D8
#define PIN_BOTAO A2
#define PIN_SCK D2
#define PIN_MISO D3
#define PIN_MOSI D4
#define PIN_CS D6
#define PIN_DC D5
#define PIN_RST -1
